[Unit]
Description=Complete FARFORMER.RU HTTPS redirect after DNS becomes ready
After=network-online.target nginx.service
Wants=network-online.target
ConditionPathExists=!/var/lib/farformer-redirect/https.ready

[Service]
Type=oneshot
WorkingDirectory=/var/www/markinai.ru
ExecStart=/usr/bin/bash /var/www/markinai.ru/deploy/activate-farformer.sh --wait
StateDirectory=farformer-redirect
StateDirectoryMode=0750
TimeoutStartSec=25h
RemainAfterExit=yes
UMask=0027

[Install]
WantedBy=multi-user.target
